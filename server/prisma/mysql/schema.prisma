// Al-Saif store database (MySQL 8). Only the backend reads or writes it; the browser never connects directly.
// The previous PostgreSQL schema is kept unchanged in ../schema.prisma as a fallback.
//
// Conventions
// - Primary keys are UUIDs stored as CHAR(36), generated by Prisma. Order numbers are customer-facing
//   integers (#1049, #1050, ...).
// - Money is DECIMAL(12,2) in SAR. Never use floats for prices.
// - Times are DATETIME(3) in UTC (MySQL keeps no time zone; the server runs with time_zone = +00:00).
// - Every text column has an explicit length matching the API's validation; MySQL rejects longer values
//   in strict mode, which the server's sql_mode enforces.
// - Tables and columns are snake_case in the database and camelCase in Prisma.
// - Soft deletes use archived_at, matching the "archive and restore" behaviour of the current dashboard.
// - legacy_id keeps the id each record has in the browser today ("phone", "p-xxxx", "laptops"), so data
//   can be imported later without breaking carts, favorites or links.
// - CHECK constraints that Prisma cannot express live in the migration SQL (prices >= 0, quantities > 0, ...).
// - JSON columns have no database default (MySQL/Prisma do not allow one); the code must always set them.
// - Unique text columns (slug, legacy_id, email, code, ...) compare case-insensitively under the default
//   utf8mb4_0900_ai_ci collation, so "Phone" and "phone" count as the same value.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  /// Used only by `prisma migrate dev` (a scratch database it may wipe). Not needed to run the API.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

/// Main departments (parent = null) and their subcategories. The store uses two levels; the original tree
/// had a third, so depth is not limited here and is enforced by the API instead.
model Category {
  id            String     @id @default(uuid()) @db.Char(36)
  legacyId      String?    @unique @map("legacy_id") @db.VarChar(100)
  slug          String     @unique @db.VarChar(120)
  parentId      String?    @map("parent_id") @db.Char(36)
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children      Category[] @relation("CategoryTree")
  nameAr        String     @map("name_ar") @db.VarChar(200)
  nameEn        String     @map("name_en") @db.VarChar(200)
  descriptionAr String     @default("") @map("description_ar") @db.VarChar(2000)
  descriptionEn String     @default("") @map("description_en") @db.VarChar(2000)
  imageUrl      String?    @map("image_url") @db.VarChar(1000)
  icon          String     @default("grid") @db.VarChar(40)
  sortOrder     Int        @default(0) @map("sort_order")
  /// Shown in the home page departments grid (main departments only).
  isFeatured    Boolean    @default(false) @map("is_featured")
  /// Switched on/off from the dashboard without deleting it.
  isVisible     Boolean    @default(true) @map("is_visible")
  archivedAt    DateTime?  @map("archived_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  products Product[]

  @@index([parentId, sortOrder])
  @@map("categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Char(36)
  legacyId         String?   @unique @map("legacy_id") @db.VarChar(100)
  sku              String?   @unique @db.VarChar(64)
  slug             String    @unique @db.VarChar(160)
  categoryId       String?   @map("category_id") @db.Char(36)
  /// RESTRICT: a category that still holds products cannot be deleted; the API archives instead.
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  nameAr           String    @map("name_ar") @db.VarChar(300)
  nameEn           String    @map("name_en") @db.VarChar(300)
  /// Short label printed above the name on product cards ("لابتوبات أعمال").
  labelAr          String    @default("") @map("label_ar") @db.VarChar(200)
  labelEn          String    @default("") @map("label_en") @db.VarChar(200)
  descriptionAr    String    @default("") @map("description_ar") @db.VarChar(4000)
  descriptionEn    String    @default("") @map("description_en") @db.VarChar(4000)
  /// Product page highlights, one short line each (JSON array of strings). Null: the storefront's built-in copy.
  featuresAr       Json?     @map("features_ar")
  featuresEn       Json?     @map("features_en")
  /// Product page spec table (JSON array of { label, value }). Null: the storefront's built-in copy.
  specsAr          Json?     @map("specs_ar")
  specsEn          Json?     @map("specs_en")
  price            Decimal   @db.Decimal(12, 2)
  /// "Was" price shown struck through; null or <= price means no visible discount.
  compareAtPrice   Decimal?  @map("compare_at_price") @db.Decimal(12, 2)
  currency         String    @default("SAR") @db.Char(3)
  /// Null means stock is not tracked for this product (the dashboard's "not recorded").
  stockQuantity    Int?      @map("stock_quantity")
  /// When false the product stays visible but cannot be ordered once tracked stock reaches zero.
  allowBackorder   Boolean   @default(false) @map("allow_backorder")
  isVisible        Boolean   @default(true) @map("is_visible")
  /// Listed in the home page offers rail.
  showInHomeOffers Boolean   @default(false) @map("show_in_home_offers")
  ratingAverage    Decimal?  @map("rating_average") @db.Decimal(2, 1)
  reviewCount      Int       @default(0) @map("review_count")
  /// Display order in lists (the storefront keeps the order products were added in).
  sortOrder        Int       @default(0) @map("sort_order")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  images           ProductImage[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  homeSectionItems HomeSectionProduct[]

  @@index([categoryId])
  @@index([isVisible, archivedAt])
  @@index([showInHomeOffers])
  @@index([sortOrder])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Path or URL in file storage. Images are never stored inside the database.
  url       String   @db.VarChar(1000)
  altAr     String   @default("") @map("alt_ar") @db.VarChar(300)
  altEn     String   @default("") @map("alt_en") @db.VarChar(300)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([productId, url(length: 255)])
  @@index([productId, sortOrder])
  @@map("product_images")
}

enum StockMovementReason {
  ORDER_PLACED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
  RESTOCK

  @@map("stock_movement_reason")
}

/// Audit trail for every stock change, written in the same transaction as the change itself.
model StockMovement {
  id          String              @id @default(uuid()) @db.Char(36)
  productId   String              @map("product_id") @db.Char(36)
  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Negative when stock leaves (an order), positive when it comes back or is restocked.
  delta       Int
  reason      StockMovementReason
  orderId     String?             @map("order_id") @db.Char(36)
  order       Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  adminUserId String?             @map("admin_user_id") @db.Char(36)
  adminUser   AdminUser?          @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  note        String?             @db.VarChar(500)
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

/// A registered store account. Guests order without one: their orders keep a contact snapshot and no
/// customer link, so registering with a phone number never exposes someone else's earlier guest orders.
model Customer {
  id           String    @id @default(uuid()) @db.Char(36)
  firstName    String    @map("first_name") @db.VarChar(60)
  lastName     String    @map("last_name") @db.VarChar(60)
  /// First and last name together, kept for order snapshots and messages.
  fullName     String    @map("full_name") @db.VarChar(120)
  /// Normalised Saudi mobile, e.g. 0512345678. The login name.
  phone        String    @unique @db.VarChar(20)
  /// Stored lower-case; unique, so one email belongs to one account.
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// One of the storefront's preset avatars (e.g. "initials-blue", "gamepad"); null shows the default icon.
  avatar       String?   @db.VarChar(40)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  addresses Address[]
  orders    Order[]
  sessions  CustomerSession[]
  emails    EmailOutbox[]

  @@map("customers")
}

/// Same scheme as admin sessions: the cookie holds a random token, the table only its SHA-256 hash.
model CustomerSession {
  id         String    @id @default(uuid()) @db.Char(36)
  customerId String    @map("customer_id") @db.Char(36)
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([customerId])
  @@map("customer_sessions")
}

enum EmailKind {
  WELCOME

  @@map("email_kind")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED

  @@map("email_status")
}

/// Emails waiting to go out. Written in the same transaction as the account, then sent and retried by the
/// API, so a mail outage never blocks or duplicates a registration. One row per customer and kind.
model EmailOutbox {
  id            String      @id @default(uuid()) @db.Char(36)
  customerId    String?     @map("customer_id") @db.Char(36)
  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  kind          EmailKind
  toAddress     String      @map("to_address") @db.VarChar(254)
  locale        String      @default("ar") @db.VarChar(5)
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  /// Short reason of the last failure, without credentials.
  lastError     String?     @map("last_error") @db.VarChar(500)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at")
  sentAt        DateTime?   @map("sent_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([customerId, kind])
  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}

model Address {
  id         String        @id @default(uuid()) @db.Char(36)
  customerId String        @map("customer_id") @db.Char(36)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  zoneId     String?       @map("zone_id") @db.Char(36)
  zone       ShippingZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  city       String        @db.VarChar(80)
  /// The customer's own name for the address ("البيت", "العمل").
  label      String        @default("") @db.VarChar(60)
  /// District, street and building number.
  line1      String        @db.VarChar(200)
  notes      String?       @db.VarChar(500)
  isDefault  Boolean       @default(false) @map("is_default")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([customerId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Shipping and payment settings
// ---------------------------------------------------------------------------

model ShippingZone {
  id        String   @id @default(uuid()) @db.Char(36)
  /// Stable code used by the app and the current dashboard ("central", "western", ...).
  code      String   @unique @db.VarChar(40)
  nameAr    String   @map("name_ar") @db.VarChar(120)
  nameEn    String   @default("") @map("name_en") @db.VarChar(120)
  citiesAr  String   @default("") @map("cities_ar") @db.VarChar(1000)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  methods   ShippingMethodZone[]
  addresses Address[]

  @@map("shipping_zones")
}

model ShippingMethod {
  id             String   @id @default(uuid()) @db.Char(36)
  code           String   @unique @db.VarChar(40)
  nameAr         String   @map("name_ar") @db.VarChar(120)
  nameEn         String   @map("name_en") @db.VarChar(120)
  isActive       Boolean  @default(true) @map("is_active")
  fee            Decimal  @db.Decimal(12, 2)
  /// Order subtotal at which shipping becomes free; null means never free.
  freeOverAmount Decimal? @map("free_over_amount") @db.Decimal(12, 2)
  minOrderAmount Decimal? @map("min_order_amount") @db.Decimal(12, 2)
  etaMinDays     Int      @default(0) @map("eta_min_days")
  etaMaxDays     Int      @default(0) @map("eta_max_days")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  zones  ShippingMethodZone[]
  orders Order[]

  @@map("shipping_methods")
}

/// Which zones each shipping method covers.
model ShippingMethodZone {
  methodId String         @map("method_id") @db.Char(36)
  method   ShippingMethod @relation(fields: [methodId], references: [id], onDelete: Cascade)
  zoneId   String         @map("zone_id") @db.Char(36)
  zone     ShippingZone   @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@id([methodId, zoneId])
  @@index([zoneId])
  @@map("shipping_method_zones")
}

enum PaymentMethodCode {
  COD
  BANK_TRANSFER
  ONLINE

  @@map("payment_method_code")
}

/// Payment options shown at checkout. Holds non-secret settings only: gateway keys and other secrets
/// belong in server environment variables or a secrets manager, never in this table.
model PaymentMethod {
  code           PaymentMethodCode @id
  nameAr         String            @map("name_ar") @db.VarChar(120)
  nameEn         String            @map("name_en") @db.VarChar(120)
  isActive       Boolean           @default(false) @map("is_active")
  extraFee       Decimal           @default(0) @map("extra_fee") @db.Decimal(12, 2)
  instructionsAr String            @default("") @map("instructions_ar") @db.VarChar(2000)
  instructionsEn String            @default("") @map("instructions_en") @db.VarChar(2000)
  /// Public, non-secret details such as bank name and account holder.
  publicConfig   Json              @map("public_config")
  sortOrder      Int               @default(0) @map("sort_order")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("payment_methods")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

/// Customer, address, shipping and payment details are copied onto the order when it is placed, so later
/// edits to the customer, a shipping method or a product never change what was actually ordered.
model Order {
  id            String            @id @default(uuid()) @db.Char(36)
  /// Order number shown in the dashboard: a database sequence starting at 1001, separate from the internal id.
  number        Int               @unique @default(autoincrement())
  /// The account that placed the order; null for guest orders.
  customerId    String?           @map("customer_id") @db.Char(36)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status        OrderStatus       @default(NEW)
  paymentStatus PaymentStatus     @default(PENDING) @map("payment_status")
  paymentMethod PaymentMethodCode @map("payment_method")

  customerName  String  @map("customer_name") @db.VarChar(120)
  customerPhone String  @map("customer_phone") @db.VarChar(20)
  customerEmail String? @map("customer_email") @db.VarChar(254)
  zoneCode      String  @map("zone_code") @db.VarChar(40)
  zoneName      String  @map("zone_name") @db.VarChar(120)
  city          String  @db.VarChar(80)
  addressLine   String  @map("address_line") @db.VarChar(200)
  notes         String? @db.VarChar(500)

  shippingMethodId   String?         @map("shipping_method_id") @db.Char(36)
  shippingMethod     ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)
  shippingMethodName String          @map("shipping_method_name") @db.VarChar(120)

  currency      String  @default("SAR") @db.Char(3)
  subtotal      Decimal @db.Decimal(12, 2)
  shippingFee   Decimal @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  paymentFee    Decimal @default(0) @map("payment_fee") @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  /// VAT is not calculated yet; the column is ready for it.
  taxTotal      Decimal @default(0) @map("tax_total") @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)
  /// Language the customer ordered in, for messages and invoices.
  locale        String  @default("ar") @db.VarChar(5)

  placedAt  DateTime @default(now()) @map("placed_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  paymentHistory PaymentStatusHistory[]
  stockMovements StockMovement[]

  @@index([status, placedAt])
  @@index([paymentStatus])
  @@index([customerId, placedAt])
  @@index([customerPhone])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Char(36)
  orderId     String   @map("order_id") @db.Char(36)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The snapshot below describes what was bought. RESTRICT: a product with orders can never be deleted, only archived.
  productId   String?  @map("product_id") @db.Char(36)
  product     Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String   @map("product_name") @db.VarChar(300)
  productSku  String?  @map("product_sku") @db.VarChar(64)
  imageUrl    String?  @map("image_url") @db.VarChar(1000)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Char(36)
  orderId     String       @map("order_id") @db.Char(36)
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  note        String?      @db.VarChar(500)
  /// Null when the change came from the storefront (order placed) or the system.
  changedById String?      @map("changed_by_id") @db.Char(36)
  changedBy   AdminUser?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model PaymentStatusHistory {
  id          String         @id @default(uuid()) @db.Char(36)
  orderId     String         @map("order_id") @db.Char(36)
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  PaymentStatus? @map("from_status")
  toStatus    PaymentStatus  @map("to_status")
  note        String?        @db.VarChar(500)
  changedById String?        @map("changed_by_id") @db.Char(36)
  changedBy   AdminUser?     @relation(fields: [changedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("payment_status_history")
}

// ---------------------------------------------------------------------------
// Store content and settings
// ---------------------------------------------------------------------------

enum HomeSectionKind {
  /// One of the storefront's own sections (hero, catalog, deals, bestsellers, addons, setups, footer).
  BUILT_IN
  /// A banner with a title, text and a button, added from the dashboard.
  BANNER
  /// A grid of hand-picked products, added from the dashboard.
  PRODUCTS

  @@map("home_section_kind")
}

/// Home page sections in display order. Text lives in content_ar / content_en as JSON because each built-in
/// section has its own fields (eyebrow, title, lead, highlight, ...), matching the current dashboard editor.
model HomeSection {
  id        String          @id @default(uuid()) @db.Char(36)
  /// "hero", "catalog", ... for built-in sections; generated for custom ones.
  key       String          @unique @db.VarChar(80)
  kind      HomeSectionKind
  sortOrder Int             @default(0) @map("sort_order")
  isVisible Boolean         @default(true) @map("is_visible")
  contentAr Json            @map("content_ar")
  contentEn Json            @map("content_en")
  /// Button target for banners, relative to the language prefix ("/offers", "/c/gaming").
  link      String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  products HomeSectionProduct[]

  @@index([sortOrder])
  @@map("home_sections")
}

model HomeSectionProduct {
  sectionId String      @map("section_id") @db.Char(36)
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  productId String      @map("product_id") @db.Char(36)
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sortOrder Int         @default(0) @map("sort_order")

  @@id([sectionId, productId])
  @@index([productId])
  @@map("home_section_products")
}

model HeroSlide {
  id          String    @id @default(uuid()) @db.Char(36)
  sortOrder   Int       @default(0) @map("sort_order")
  titleAr     String    @map("title_ar") @db.VarChar(200)
  titleRestAr String    @default("") @map("title_rest_ar") @db.VarChar(200)
  leadAr      String    @default("") @map("lead_ar") @db.VarChar(1000)
  titleEn     String    @map("title_en") @db.VarChar(200)
  titleRestEn String    @default("") @map("title_rest_en") @db.VarChar(200)
  leadEn      String    @default("") @map("lead_en") @db.VarChar(1000)
  imageUrl    String?   @map("image_url") @db.VarChar(1000)
  isVisible   Boolean   @default(true) @map("is_visible")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@map("hero_slides")
}

/// Small store-wide settings as key/value JSON: brand (name, tagline, logo), low-stock threshold, contact
/// details. Not for secrets.
model StoreSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

// ---------------------------------------------------------------------------
// Admin users (server-side authentication)
// ---------------------------------------------------------------------------

enum AdminRole {
  /// Full access, including other admins.
  OWNER
  /// Everything except managing admins.
  MANAGER
  /// Products, categories and content.
  EDITOR
  /// Orders and customers.
  SUPPORT

  @@map("admin_role")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Char(36)
  /// Stored lower-case; the API normalises before saving and before lookups.
  email        String    @unique @db.VarChar(254)
  fullName     String    @map("full_name") @db.VarChar(120)
  /// scrypt hash produced on the server (see src/auth/password.ts). Plain passwords are never stored or logged.
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  sessions       AdminSession[]
  orderChanges   OrderStatusHistory[]
  paymentChanges PaymentStatusHistory[]
  stockChanges   StockMovement[]

  @@map("admin_users")
}

/// Server-side sessions. Only a hash of the session token is stored, so a database leak does not leak
/// usable sessions; the raw token lives in an httpOnly cookie.
model AdminSession {
  id          String    @id @default(uuid()) @db.Char(36)
  adminUserId String    @map("admin_user_id") @db.Char(36)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  userAgent   String?   @map("user_agent") @db.VarChar(300)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}
