# Copy this file to server/.env and replace the placeholder values. Never commit server/.env.
# These values are for the backend only. Nothing here may be prefixed with VITE_ or read by the frontend.

# Local MySQL (see "macOS 12 (Monterey) without Docker" in README.md). URL-encode special characters in the
# password (@ : / ? # %).
DATABASE_URL="mysql://alsaif:change-me-to-a-long-random-password@127.0.0.1:3306/alsaif"
# Scratch database that `prisma migrate dev` may wipe. Not needed to run the API.
SHADOW_DATABASE_URL="mysql://alsaif:change-me-to-a-long-random-password@127.0.0.1:3306/alsaif_shadow"

# API server (optional; these are the defaults)
# HOST=127.0.0.1
# PORT=4000
# Frontends allowed to call the API from a browser, comma-separated
# CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175
# Admin session lifetime in hours
# SESSION_TTL_HOURS=12

# Previous PostgreSQL setup, kept as a fallback (see "PostgreSQL fallback" in README.md)
# POSTGRES_USER=alsaif
# POSTGRES_PASSWORD=change-me-to-a-long-random-password
# POSTGRES_DB=alsaif
# POSTGRES_PORT=5433
# DATABASE_URL="postgresql://alsaif:change-me-to-a-long-random-password@127.0.0.1:5433/alsaif?schema=public"

# Where product photos uploaded from the dashboard are saved (defaults: ../public/uploads, served as /uploads)
# UPLOAD_DIR=
# UPLOAD_URL_PREFIX=/uploads

# Customer accounts: how long a customer stays signed in on a device (days), and the storefront address used in
# emails. Both optional.
# CUSTOMER_SESSION_DAYS=30
# STORE_URL=http://localhost:5175

# Outgoing email (the welcome message after registration). Any SMTP provider works: Amazon SES, SendGrid,
# Mailgun, Zoho, Google Workspace... Without SMTP_HOST, emails stay queued (MAIL_TRANSPORT=off) and are sent
# automatically once SMTP is configured. MAIL_TRANSPORT=log writes each email to server/mail-log/ instead of
# sending it (local testing only).
# MAIL_TRANSPORT=smtp
# SMTP_HOST=email-smtp.me-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=change-me
# SMTP_PASSWORD=change-me
# MAIL_FROM="Al-Saif Store <no-reply@your-domain.com>"
